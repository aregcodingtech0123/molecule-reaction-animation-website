# Copy to `.env.test` (gitignored). Only the keys below are read by the test
# harness (scripts/test/test-env-file.mjs) — application secrets are NEVER
# loaded from files in tests; each suite defines generated test values itself.

# Must be a LOCAL database whose name contains "test" (enforced by scripts/test/db-guard.mjs).
# `npm run test:db:up` starts one on this port via docker-compose.test.yml.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/moleculestudio_test

# INTERNAL_SERVICE_SECRET is NOT read from this file: every suite sets a generated
# test-only value itself (placeholder shown for completeness).
# INTERNAL_SERVICE_SECRET=replace-with-at-least-32-characters-internal-key

# Ports used by Playwright's dedicated Next.js / Express servers (never your dev ports).
E2E_WEB_PORT=3100
E2E_API_PORT=4100
