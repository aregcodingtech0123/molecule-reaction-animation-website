{
  "name": "moleculerarchitecturestudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "npm run dev --prefix services/auth-billing-service",
    "dev:all": "node scripts/ensure-docker.mjs && concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:all:nodocker": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "check:config": "node services/auth-billing-service/node_modules/tsx/dist/cli.mjs scripts/check-config.mts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "db:setup": "npm run db:setup --prefix services/auth-billing-service",
    "db:reset": "npm run db:reset --prefix services/auth-billing-service",
    "test": "vitest run && npm test --prefix services/auth-billing-service",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:db": "npm run test:db --prefix services/auth-billing-service",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage && npm run test:coverage --prefix services/auth-billing-service",
    "test:db:prepare": "node scripts/test/prepare-test-db.mjs",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/genai": "^2.5.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.41.0",
    "jose": "^6.2.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.14.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "~4.1.12",
    "autocannon": "8.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "~4.1.12"
  }
}
