{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"],
      "pg": ["./node_modules/@types/pg/index.d.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "tests/**/*.mts", "*.mts"],
  "exclude": ["node_modules", "services", ".next", ".next-e2e"]
}
