# ── MoleculeStudio API Gateway (BFF) ─────────────────────────────────────────
# Internal microservice base URLs (no trailing slash)
AUTH_SERVICE_URL=http://localhost:4000/api/auth
BILLING_SERVICE_URL=http://localhost:4000/api/billing
USERS_SERVICE_URL=http://localhost:4000/api/users

# Distributed rate limiting for /api/chat (optional — in-memory fallback when unset)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Frontend origin (set-cookie CSRF guard + auth-billing-service FRONTEND_URL)
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# The Next.js app does NOT connect to Postgres directly.
# Configure DATABASE_URL only in services/auth-billing-service/.env
#
# Local Docker (default):
#   postgresql://postgres:postgres_dev_password@localhost:5432/molecule_studio_db
# Production Supabase:
#   postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require

# ── Internal service key (REQUIRED; must equal auth-billing-service INTERNAL_SERVICE_SECRET) ─
# Sent server-side as X-Internal-Service-Key on AI credit metering calls. Never exposed to the
# browser. Generate with: openssl rand -base64 48   (≥ 32 chars; the server refuses to start otherwise)
INTERNAL_SERVICE_SECRET=replace-with-at-least-32-characters-internal-key

# ── Client IP for rate limiting (FINDING-04) ─────────────────────────────────
# Header that YOUR PLATFORM sets with the end user's IP (clients must not be able to forge it).
# Vercel: x-forwarded-for · nginx: x-real-ip (proxy_set_header X-Real-IP $remote_addr) · Cloudflare: cf-connecting-ip
# Unset → the BFF forwards no client IP and all users share one rate-limit bucket (warned at startup in production).
# CLIENT_IP_HEADER=x-forwarded-for

# ── AI Lab ───────────────────────────────────────────────────────────────────
# Abort a Gemini call after this many ms; the credit reservation is then released (default 30000).
# GEMINI_TIMEOUT_MS=30000
# Backoff (ms) between capture/release retries to the billing service (default 250,1000,3000,8000,15000:
# ~27 s, so a turn's charge survives a ~30 s billing or database outage; the answer waits for it).
# BILLING_RETRY_DELAYS_MS=250,1000,3000,8000,15000

# ── JWT (must match auth-billing-service JWT_SECRET for /api/chat + middleware) ─
JWT_SECRET=replace-with-at-least-32-characters-secret-key

# ── JWT & OAuth (auth-billing-service) ────────────────────────────────────────
# JWT_EXPIRES_IN=7d
# BCRYPT_ROUNDS=10
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Email (auth-billing-service — verification & password reset) ──────────────
# RESEND_API_KEY=
# EMAIL_FROM=MoleculeStudio <onboarding@resend.dev>

# ── Existing app secrets ─────────────────────────────────────────────────────
GEMINI_API_KEY=

# Google OAuth (must match auth-billing-service GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Lemon Squeezy (billing is configured on auth-billing-service) ─────────────
# Canonical: services/auth-billing-service/.env — put real values in local .env only
# LEMONSQUEEZY_STORE_ID=your_store_id
# LEMONSQUEEZY_API_KEY=your_api_key
# LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
# LEMONSQUEEZY_VARIANT_STARTER=your_starter_variant_id
# LEMONSQUEEZY_VARIANT_PRO=your_pro_variant_id
# LEMONSQUEEZY_VARIANT_ENTERPRISE=your_enterprise_variant_id
# Optional, build-time: the same variant ids, so `/login?variant_id=<id>` deep links resolve to a pack.
# Unset → such links are ignored (the pack picker still works). No hard-coded fallback (FINDING-13).
# NEXT_PUBLIC_LEMONSQUEEZY_VARIANT_STARTER=your_starter_variant_id
# NEXT_PUBLIC_LEMONSQUEEZY_VARIANT_PRO=your_pro_variant_id
# NEXT_PUBLIC_LEMONSQUEEZY_VARIANT_ENTERPRISE=your_enterprise_variant_id
