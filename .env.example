# ── MoleculeStudio API Gateway (BFF) ─────────────────────────────────────────
# Internal microservice base URLs (no trailing slash)
AUTH_SERVICE_URL=http://localhost:4000/api/auth
BILLING_SERVICE_URL=http://localhost:4000/api/billing
USERS_SERVICE_URL=http://localhost:4000/api/users

# SECURITY-TODO: AI_ENGINE_URL /api/ai BFF route removed — use /api/chat only.
# If re-enabling a legacy Python AI engine, keep it on a private network only.

# Distributed rate limiting for /api/chat (optional — in-memory fallback when unset)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Frontend origin (set-cookie CSRF guard + auth-billing-service FRONTEND_URL)
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# The Next.js app does NOT connect to Postgres directly.
# Configure DATABASE_URL only in services/auth-billing-service/.env
#
# Local Docker (default):
#   postgresql://postgres:postgres_dev_password@localhost:5432/molecule_studio_db
# Production Supabase:
#   postgresql://postgres.[REF]:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require

# ── JWT (must match auth-billing-service JWT_SECRET for /api/chat + middleware) ─
JWT_SECRET=replace-with-at-least-32-characters-secret-key

# ── JWT & OAuth (auth-billing-service) ────────────────────────────────────────
# JWT_EXPIRES_IN=7d
# BCRYPT_ROUNDS=10
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Email (auth-billing-service — verification & password reset) ──────────────
# RESEND_API_KEY=
# EMAIL_FROM=MoleculeStudio <onboarding@resend.dev>

# ── Existing app secrets ─────────────────────────────────────────────────────
GEMINI_API_KEY=

# Google OAuth (must match auth-billing-service GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Lemon Squeezy (billing is configured on auth-billing-service) ─────────────
# Canonical: services/auth-billing-service/.env — put real values in local .env only
# LEMONSQUEEZY_STORE_ID=your_store_id
# LEMONSQUEEZY_API_KEY=your_api_key
# LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
# LEMONSQUEEZY_VARIANT_STARTER=your_starter_variant_id
# LEMONSQUEEZY_VARIANT_PRO=your_pro_variant_id
# LEMONSQUEEZY_VARIANT_ENTERPRISE=your_enterprise_variant_id
