{
  "name": "@moleculestudio/auth-billing-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:server": "tsx watch --clear-screen=false src/index.ts",
    "db:setup": "node scripts/setup-db.mjs",
    "db:migrate": "node scripts/setup-db.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "db:migrate-profiles": "node scripts/migrate-user-profiles.mjs",
