PORT=4000
NODE_ENV=development

# =============================================================================
# PostgreSQL — pick ONE mode. Never point local .env at production Supabase.
# =============================================================================

# ── LOCAL (Docker Compose — default for development) ─────────────────────────
# From repo root:  docker compose up -d
# Then:            npm run db:setup
#
# Matches docker-compose.yml credentials exactly.
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/molecule_studio_db

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
DB_NAME=molecule_studio_db

# ── PRODUCTION (Supabase Postgres — hosted) ──────────────────────────────────
# Comment out the LOCAL block above and set:
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Notes:
#   - Always include ?sslmode=require for Supabase.
#   - Database name is usually `postgres` (not molecule_studio_db).
#   - Prefer the Direct connection (port 5432) for this long-lived Express service.
#   - Do NOT run npm run db:reset against Supabase.
#   - Apply migrations once with: npm run db:setup  (idempotent SQL)

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-characters-secret-key
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ── Google OAuth (Web client ID from Google Cloud Console) ────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

FRONTEND_URL=http://localhost:3000

# ── Transactional email (Resend) ──────────────────────────────────────────────
# https://resend.com — required in production for verification, password reset & receipts
RESEND_API_KEY=
# Display name + address (verified domain in Resend, or onboarding@resend.dev for tests)
SENDER_EMAIL=MoleculeStudio <onboarding@resend.dev>
# Legacy alias (optional) — used only if SENDER_EMAIL is empty
# EMAIL_FROM=MoleculeStudio <onboarding@resend.dev>

# ── Lemon Squeezy (Global / USD Merchant of Record) ───────────────────────────
# Put real values only in local .env (gitignored) — never commit secrets here.
LEMONSQUEEZY_API_KEY=your_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
# Variant IDs from Lemon Squeezy products (one per credit pack)
LEMONSQUEEZY_VARIANT_STARTER=your_starter_variant_id
LEMONSQUEEZY_VARIANT_PRO=your_pro_variant_id
LEMONSQUEEZY_VARIANT_ENTERPRISE=your_enterprise_variant_id
# Configure Lemon webhook URL to:
#   https://YOUR_PUBLIC_HOST/api/billing/webhooks/lemonsqueezy
# Subscribe to: order_created
# Dashboard signing secret must match LEMONSQUEEZY_WEBHOOK_SECRET.
