# Environment of the SEPARATE webhook ingestion process (Step 7.5, O-1 Option B). Copy to `.env.ingest` (gitignored) or set the
# variables in the host's secret store. `npm run start:ingest` loads ONLY this file, never `.env`.
#
# It must NOT contain anything of the main service's `.env`: DATABASE_URL, MIGRATION_DATABASE_URL, ACK_DATABASE_URL, DB_PASSWORD,
# JWT_SECRET, INTERNAL_SERVICE_SECRET, SETTLEMENT_CAPABILITY_SECRET(_PREVIOUS), EMAIL_TOMBSTONE_SECRET, LEMONSQUEEZY_API_KEY,
# RESEND_API_KEY. The process refuses to start when one of them is set.

# The webhook role's own login (created by database/staged/phase-2c-v7/S3-webhook-role-creation.sql). The user MUST be
# moleculestudio_webhook; the password is set out of band. Same database as the main service.
WEBHOOK_DATABASE_URL=postgresql://moleculestudio_webhook:SET_OUT_OF_BAND@HOST:5432/DATABASE?sslmode=require

# Signing secret of the Lemon webhook (>= 32 random characters in production). Only this process needs it.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Owner-supplied values, no defaults: the store id and the three variant ids (distinct, numeric).
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_ENTERPRISE=

# Test mode is OFF in production (owner decision O-3): leave unset. Honoured only when NODE_ENV=development or test.
# LEMONSQUEEZY_ALLOW_TEST_MODE=true

# Optional. INGEST_PORT default 4001, INGEST_HOST default 127.0.0.1 (production) / 0.0.0.0 (development),
# WEBHOOK_STORE_TIMEOUT_MS default 3000.
# INGEST_PORT=4001
NODE_ENV=production
