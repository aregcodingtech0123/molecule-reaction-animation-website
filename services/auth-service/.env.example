# MoleculeStudio Auth Service

PORT=4001
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/molecule_studio_db

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=molecule_studio_db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-characters-secret-key
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SIGNUP_CREDIT_AMOUNT=10

# Billing sync — base URL without /internal suffix
BILLING_SERVICE_URL=http://localhost:4002
INTERNAL_API_KEY=change-me-to-a-long-random-secret

CORS_ORIGINS=http://localhost:3000

# Gateway: AUTH_SERVICE_URL=http://localhost:4001/auth
