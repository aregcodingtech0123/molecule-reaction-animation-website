# MoleculeStudio AI Engine

PORT=8000
HOST=0.0.0.0
ENV=development

# Google AI Studio / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional billing integration (deduct before generation)
BILLING_SERVICE_URL=http://localhost:4002
INTERNAL_API_KEY=change-me-to-a-long-random-secret
CREDIT_COST_PER_GENERATION=1

# Gateway base URL must include /ai prefix:
#   POST /api/ai/generate-molecule  →  {AI_ENGINE_URL}/generate-molecule
# Example: AI_ENGINE_URL=http://localhost:8000/ai
