# MoleculeStudio Billing Service

PORT=4002
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/molecule_studio_db

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=molecule_studio_db

# Internal service-to-service auth (deduct, grant, balance from AI engine)
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Comma-separated origins or * for dev
CORS_ORIGINS=http://localhost:3000

# Gateway base URL must include /billing prefix:
#   POST /api/billing/webhook  →  {BILLING_SERVICE_URL}/webhook
# Example: BILLING_SERVICE_URL=http://localhost:4002/billing
